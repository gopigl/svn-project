apiVersion: v1
kind: Pod
metadata:
  name: sql-python-test
  namespace: default
  labels:
    app: sql-test
    azure.workload.identity/use: "true"
spec:
  serviceAccountName: sql-workload-sa
  containers:
  - name: python-sql
    image: python:3.11-slim
    command:
      - /bin/bash
      - -c
      - |
        # Install dependencies
        echo "Installing dependencies..."
        apt-get update -qq
        apt-get install -y -qq \
          unixodbc-dev \
          curl \
          gnupg \
          apt-transport-https > /dev/null 2>&1
        
        # Add Microsoft repository for ODBC driver
        echo "Adding Microsoft repository..."
        curl https://packages.microsoft.com/keys/microsoft.asc | apt-key add - > /dev/null 2>&1
        curl https://packages.microsoft.com/config/debian/11/prod.list | tee /etc/apt/sources.list.d/mssql-release.list > /dev/null 2>&1
        apt-get update -qq
        
        # Install ODBC driver
        echo "Installing ODBC driver..."
        ACCEPT_EULA=Y apt-get install -y -qq msodbcsql18 > /dev/null 2>&1
        
        # Install Python packages
        echo "Installing Python packages..."
        pip install --quiet pyodbc azure-identity
        
        echo "Setup complete!"
        echo ""
        
        # Run Python script
        python3 << 'PYTHON_SCRIPT'
import os
import sys
import subprocess

# Configuration from environment
SQL_SERVER = os.environ.get('SQL_SERVER', 'your-sql-server.database.windows.net')
SQL_DATABASE = os.environ.get('SQL_DATABASE', 'your-database')
MANAGED_IDENTITY_CLIENT_ID = os.environ.get('MANAGED_IDENTITY_CLIENT_ID', 'your-managed-identity-client-id')
TOKEN_FILE = '/var/run/secrets/azure/tokens/token'

print("=" * 70)
print("SQL CONNECTION TEST - PYTHON SCRIPT")
print("=" * 70)
print()

# Step 1: Check environment
print("Step 1: Checking Workload Identity Setup...")
print()

print("  Checking Azure environment variables:")
azure_vars = ['AZURE_CLIENT_ID', 'AZURE_TENANT_ID', 'AZURE_FEDERATED_TOKEN_FILE', 'AZURE_AUTHORITY_HOST']
for var in azure_vars:
    value = os.environ.get(var)
    if value:
        print(f"    ✓ {var}: {value[:50]}...")
    else:
        print(f"    ✗ {var}: NOT SET")

print()

# Step 2: Read token
print("Step 2: Reading Token from File...")
print()

if not os.path.isfile(TOKEN_FILE):
    print(f"  ✗ Token file not found: {TOKEN_FILE}")
    print()
    print("  Searching for alternative paths...")
    found = False
    for alt_path in ['/run/secrets/azure/tokens/token', 
                     os.environ.get('AZURE_FEDERATED_TOKEN_FILE', '')]:
        if alt_path and os.path.isfile(alt_path):
            print(f"  ✓ Found at: {alt_path}")
            TOKEN_FILE = alt_path
            found = True
            break
    
    if not found:
        print("  ✗ No token file found anywhere")
        print()
        print("  Files in /var/run/secrets:")
        subprocess.run(['find', '/var/run/secrets', '-type', 'f'], capture_output=False)
        print()
        print("  Files in /run/secrets:")
        subprocess.run(['find', '/run/secrets', '-type', 'f'], capture_output=False)
        sys.exit(1)

try:
    with open(TOKEN_FILE, 'r') as f:
        token = f.read().strip()
    print(f"  ✓ Token file read successfully")
    print(f"    File: {TOKEN_FILE}")
    print(f"    Size: {len(token)} characters")
except Exception as e:
    print(f"  ✗ Failed to read token: {e}")
    sys.exit(1)

if not token:
    print("  ✗ Token is empty!")
    sys.exit(1)

print(f"    Preview: {token[:60]}...")
print()

# Step 3: Validate token
print("Step 3: Validating Token...")
print()

if token.startswith('eyJ'):
    print("  ✓ Valid JWT format (starts with eyJ)")
    dot_count = token.count('.')
    print(f"  ✓ Contains {dot_count} dots")
else:
    print("  ✗ Not a valid JWT token!")
    print(f"    First 100 chars: {token[:100]}")
    if 'edit.com' in token:
        print("  ✗ Token contains 'edit.com' - workload identity may not be configured!")
    sys.exit(1)

print()

# Step 4: Check connectivity
print("Step 4: Checking Network Connectivity...")
print()

import socket
try:
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(3)
    result = sock.connect_ex((SQL_SERVER.split('.')[0], 1433))
    sock.close()
    if result == 0:
        print(f"  ✓ Can reach {SQL_SERVER}:1433")
    else:
        print(f"  ⚠ Cannot reach {SQL_SERVER}:1433 (firewall may block)")
except Exception as e:
    print(f"  ⚠ Network check failed: {e}")

print()

# Step 5: Connect to SQL
print("Step 5: Connecting to SQL Database...")
print()

print(f"  SQL Server: {SQL_SERVER}")
print(f"  Database: {SQL_DATABASE}")
print(f"  Client ID: {MANAGED_IDENTITY_CLIENT_ID}")
print()

try:
    import pyodbc
    
    connection_string = (
        f"Driver={{ODBC Driver 17 for SQL Server}};"
        f"Server=tcp:{SQL_SERVER},1433;"
        f"Database={SQL_DATABASE};"
        f"Encrypt=yes;"
        f"TrustServerCertificate=no;"
        f"Connection Timeout=30;"
        f"Authentication=ActiveDirectoryPassword;"
        f"UID={MANAGED_IDENTITY_CLIENT_ID};"
        f"PWD={token};"
    )
    
    print("  Attempting connection...")
    conn = pyodbc.connect(connection_string)
    cursor = conn.cursor()
    
    print("  ✓ Connection successful!")
    print()
    
    # Step 6: Run query
    print("Step 6: Running Test Query...")
    print()
    
    cursor.execute("SELECT DB_NAME() as [Database], @@VERSION as [Version], SUSER_NAME() as [User]")
    row = cursor.fetchone()
    
    if row:
        print(f"  ✓ Query successful!")
        print(f"    Database: {row[0]}")
        print(f"    SQL Version: {row[1][:100]}...")
        print(f"    Current User: {row[2]}")
    
    conn.close()
    
    print()
    print("=" * 70)
    print("✓ ALL TESTS PASSED - CONNECTION WORKING!")
    print("=" * 70)
    
except pyodbc.Error as e:
    print(f"  ✗ Connection failed!")
    print(f"  Error: {e}")
    print()
    print("  Possible causes:")
    print("    1. Managed Identity not created as SQL Database user")
    print("    2. Managed Identity doesn't have database permissions")
    print("    3. SQL Server doesn't allow Entra ID authentication")
    print("    4. Invalid SQL Server name or database name")
    print()
    print("  To fix:")
    print("    1. Connect with SQL admin credentials")
    print("    2. Run: CREATE USER [managed-identity-name] FROM EXTERNAL PROVIDER;")
    print("    3. Run: ALTER ROLE db_datareader ADD MEMBER [managed-identity-name];")
    sys.exit(1)

except Exception as e:
    print(f"  ✗ Error: {e}")
    import traceback
    traceback.print_exc()
    sys.exit(1)
PYTHON_SCRIPT

    env:
    - name: SQL_SERVER
      value: "your-sql-server.database.windows.net"
    - name: SQL_DATABASE
      value: "your-database"
    - name: MANAGED_IDENTITY_CLIENT_ID
      value: "your-managed-identity-client-id"
    - name: TOKEN_FILE
      value: "/var/run/secrets/azure/tokens/token"
    
    resources:
      requests:
        memory: "256Mi"
        cpu: "100m"
      limits:
        memory: "512Mi"
        cpu: "500m"

  restartPolicy: Never
  terminationGracePeriodSeconds: 10
