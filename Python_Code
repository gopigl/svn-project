# Complete installation with tdnf
tdnf update -y
tdnf install -y python3 python3-pip unixodbc-devel curl ca-certificates
curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | tee /etc/pki/tls/certs/microsoft.crt
curl -fsSL https://packages.microsoft.com/config/mariner/2.0/prod.repo | tee /etc/yum.repos.d/microsoft.repo
tdnf install -y msodbcsql18 mssql-tools18
pip3 install pyodbc
export PATH="/opt/mssql-tools18/bin:$PATH"
