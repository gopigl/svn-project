import java.sql.*;
import java.util.Properties;

public class DbTest {
    public static void main(String[] args) throws Exception {
        String url = "jdbc:sqlserver://test-db-ericsson.database.windows.net:1433"
                   + ";database=test-db01;encrypt=true;loginTimeout=30";

        Properties props = new Properties();
        props.setProperty("accessToken", System.getenv("TOKEN"));

        try (Connection conn = DriverManager.getConnection(url, props);
             ResultSet rs = conn.createStatement()
                 .executeQuery("SELECT SUSER_SNAME(), DB_NAME()")) {
            rs.next();
            System.out.println("CONNECTED as " + rs.getString(1) + " on " + rs.getString(2));
        }
    }
}

