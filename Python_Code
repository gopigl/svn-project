import json, os, struct, urllib.parse, urllib.request, pyodbc

body = urllib.parse.urlencode({
    "client_id": os.environ["AZURE_CLIENT_ID"],
    "scope": "https://database.windows.net/.default",
    "grant_type": "client_credentials",
    "client_assertion_type": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer",
    "client_assertion": open(os.environ["AZURE_FEDERATED_TOKEN_FILE"]).read(),
}).encode()

url = f"{os.environ['AZURE_AUTHORITY_HOST']}{os.environ['AZURE_TENANT_ID']}/oauth2/v2.0/token"
token = json.load(urllib.request.urlopen(urllib.request.Request(url, data=body)))["access_token"]

tb = token.encode("utf-16-le")
conn = pyodbc.connect(
    "DRIVER={ODBC Driver 18 for SQL Server};"
    "SERVER=test-db-ericsson.database.windows.net;"
    "DATABASE=test-db01;Encrypt=yes;",
    attrs_before={1256: struct.pack(f"<I{len(tb)}s", len(tb), tb)},
)
print(conn.cursor().execute("SELECT SUSER_SNAME(), @@VERSION").fetchone())
